# PDFs are binary artifacts, including Poppler files with long ASCII prefixes.
*.pdf binary

# Complete source compilations retain original Markdown hard breaks and EOFs.
docs/handoff/*.md whitespace=-blank-at-eol,-blank-at-eof

# Frozen Round 19 source snapshots retain original end-of-file blank lines.
research/dyson/round19/** whitespace=-blank-at-eof

# Frozen Round 20 source snapshots retain original EOF blank lines.
research/dyson/round20/** whitespace=-blank-at-eof

# Preserve Python csv.writer CRLF bytes in frozen Round 20 data.
research/dyson/round20/actual-prime-variance/*.csv whitespace=cr-at-eol

# Preserve five original R21 trailing blank lines in source/history files.
research/dyson/round21/coordinator-review/CENTERED_PAIR_ERROR_TARGET.md whitespace=-blank-at-eof
